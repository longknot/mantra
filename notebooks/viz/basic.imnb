      "value": "import viz;\n\nk = 6.282;\nstep = 0.1;\n\n{ viz.line_range \"chart\" ( 0 .. k by step ) ( sin x ) \"sin x\" };\n{ viz.line_range \"chart\" ( 0 .. k by step ) ( cos x ) \"cos x\" };\n\n{ assign_path \"chart.width\" 640 };\n{ assign_path \"chart.height\" 400 };\n\n{ viz.show \"chart\" };",
